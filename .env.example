# ===== MySQL =====
# Contraseña del usuario root (usar un valor fuerte en producción)
MYSQL_ROOT_PASSWORD=change_me_root
# Base de datos creada automáticamente al iniciar
MYSQL_DATABASE=app_db
# Usuario de la aplicación (sin privilegios de root)
MYSQL_USER=app_user
MYSQL_PASSWORD=change_me_app

# ===== Laravel =====
# Generar con: docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_ENV=production
APP_DEBUG=false
# URL pública de la API
APP_URL=http://localhost:8000
# true = ejecuta php artisan migrate --force al iniciar el contenedor
RUN_MIGRATIONS=true

# ===== Puertos publicados en el host =====
API_PORT=8000
FRONTEND_PORT=3000

# ===== Next.js =====
# URL de la API vista desde el NAVEGADOR (se incrusta en el build)
NEXT_PUBLIC_API_URL=http://localhost:8000
